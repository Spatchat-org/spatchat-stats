# Copy this file to .env and fill in values.

# Required: LLM backend (Together AI) used to power the chat assistant.
TOGETHER_API_KEY=

# Optional: override the default Together model.
# TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# Optional: use a Hugging Face Inference Endpoint instead of/alongside Together.
# HF_TOKEN=
# HF_ENDPOINT_URL=
# HF_MODEL=
